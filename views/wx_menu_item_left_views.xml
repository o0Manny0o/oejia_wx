<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>

        <record id="wx_menu_item_left_view_form" model="ir.ui.view">
            <field name="name">wx.menu.item.left.view_form</field>
            <field name="model">wx.menu.item.left</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="左菜单项" version="7.0">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="action"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="wx_menu_item_left_view_list" model="ir.ui.view">
            <field name="name">wx.menu.item.left.view_list</field>
            <field name="model">wx.menu.item.left</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list string="左菜单项">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="action"/>
                </list>
            </field>
        </record>

    </data>
</openerp>